                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="MIN" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="SEN" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="SEL" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="RAB" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" />
                                            <TextBlock Grid.Column="4" Text="KAM" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" />
                                            <TextBlock Grid.Column="5" Text="JUM" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" />
                                            <TextBlock Grid.Column="6" Text="SAB" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" />
                                        </Grid>

                                        <!-- Month Calendar Uniform Grid (Day Cells) -->
                                        <Border x:Name="CalendarGridFrame" Background="#141024" BorderBrush="#3D2D64" BorderThickness="1" CornerRadius="8" Padding="1" Margin="0,2,0,0">
                                            <UniformGrid x:Name="CalendarMonthGrid" Columns="7" Rows="6" MinHeight="265" />
                                        </Border>

                                        <!-- Selected Day Events Detail Section (When user clicks any day) -->
                                        <Border x:Name="SelectedDayDetailBorder" Background="#201A30" BorderBrush="#3D305C" BorderThickness="1" CornerRadius="10" Padding="10,8" Margin="0,8,0,0" Visibility="Collapsed">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,4">
                                                    <TextBlock x:Name="SelectedDayTitleText" Text="Agenda Terpilih" Foreground="{StaticResource LavenderBrush}" FontSize="11" FontWeight="Bold" />
                                                    <Button Style="{StaticResource DarkIslandButton}" Content="✕" Width="18" Height="18" Padding="0" HorizontalAlignment="Right" Click="CloseSelectedDayDetail_Click" />
                                                </Grid>
                                                <StackPanel x:Name="SelectedDayEventsPanel" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- TAB 9: SETTINGS -->
                            <StackPanel x:Name="PanelSettings" Visibility="Collapsed">
                                <Border Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="PREFERENCES &amp; ACCESSIBILITY" Style="{StaticResource SectionLabel}" Margin="0,0,0,8" />

                                        <Grid Margin="0,4,0,8">
                                            <StackPanel>
                                                <TextBlock Text="Audio Chime Notifications" Foreground="{StaticResource MainTextBrush}" FontSize="12" FontWeight="Bold" />
                                                <TextBlock Text="Bunyikan nada saat AI selesai atau timer selesai" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                                            </StackPanel>
                                            <Button x:Name="SettingsSoundBtn" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource PikoButton}" Content="Enabled" Click="ToggleSound_Click" />
                                        </Grid>

                                        <Grid Margin="0,4,0,8">
                                            <StackPanel>
                                                <TextBlock Text="Do Not Disturb Mode" Foreground="{StaticResource MainTextBrush}" FontSize="12" FontWeight="Bold" />
                                                <TextBlock Text="Redam suara tanpa mematikan animasi mata" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                                            </StackPanel>
                                            <Button x:Name="SettingsDndBtn" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource PikoButton}" Content="Disabled" Click="ToggleDnd_Click" />
                                        </Grid>

                                        <!-- Dark Mode Toggle -->
                                        <Grid Margin="0,4,0,8">
                                            <StackPanel>
                                                <TextBlock Text="🌙 Dark Mode" Foreground="{StaticResource MainTextBrush}" FontSize="12" FontWeight="Bold" />
                                                <TextBlock Text="Tampilan gelap elegan dengan aksen ungu" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                                            </StackPanel>
                                            <Button x:Name="SettingsDarkModeBtn" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource PikoButton}" Content="Off" Click="ToggleDarkMode_Click" />
                                        </Grid>

                                        <!-- Reduced-Motion Accessibility Toggle -->
                                        <Grid Margin="0,4,0,8">
                                            <StackPanel>
                                                <TextBlock Text="Reduced Motion (Aksesibilitas)" Foreground="{StaticResource MainTextBrush}" FontSize="12" FontWeight="Bold" />
                                                <TextBlock Text="Hilangkan animasi bounce dan percepat transisi panel" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                                            </StackPanel>
                                            <Button x:Name="SettingsReducedMotionBtn" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource PikoButton}" Content="Off" Click="ToggleReducedMotion_Click" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- AI BRIDGE & NOTIFICATIONS CARD (Merged from Tab AI) -->
                                <Border Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <Grid>
                                            <StackPanel>
                                                <TextBlock Text="AI COMPLETION BRIDGE &amp; EXTENSION" Style="{StaticResource SectionLabel}" />
                                                <TextBlock x:Name="AINotificationTitle" Text="Your AI companion is on standby" Foreground="{StaticResource MainTextBrush}" FontSize="15" FontWeight="Bold" Margin="0,3,0,0" TextWrapping="Wrap" />
                                                <TextBlock x:Name="AIStatusText" Text="Mendukung ChatGPT, Gemini, Claude, DeepSeek, dan Antigravity IDE. Piko memantau dan memberi tahu secara cerdas saat satu atau beberapa AI berpikir bersamaan ✨" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <Border x:Name="AIStatusBadge" HorizontalAlignment="Right" VerticalAlignment="Top" Background="{StaticResource SoftChipBrush}" BorderBrush="{StaticResource LightPurpleBrush}" BorderThickness="1" CornerRadius="8" Padding="8,4">
                                                <TextBlock x:Name="AIStatusBadgeText" Text="STANDBY" Foreground="{StaticResource PrimaryVioletBrush}" FontSize="9" FontWeight="Bold" />
                                            </Border>
                                        </Grid>

                                        <Border Background="#F7F4FF" BorderBrush="{StaticResource LightPurpleBrush}" BorderThickness="1" CornerRadius="10" Padding="10,8" Margin="0,10,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="Local Bridge: 127.0.0.1:17321" Foreground="{StaticResource MainTextBrush}" FontSize="11" FontWeight="Bold" />
                                                    <TextBlock x:Name="BridgeConnectionHint" Text="Loopback only · Strict token validation · Antigravity IDE Auto-Watcher Active" Foreground="{StaticResource MutedBrush}" FontSize="9" Margin="0,2,0,0" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Background="#EDE5FF" CornerRadius="6" Padding="6,3" Margin="0,0,4,0">
                                                        <TextBlock x:Name="BridgeActiveText" Text="LISTENING" Foreground="{StaticResource PrimaryVioletBrush}" FontSize="9" FontWeight="Bold" />
                                                    </Border>
                                                    <Border Background="#E0F2FE" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="6" Padding="6,3">
                                                        <TextBlock Text="ANTIGRAVITY ON ⚡" Foreground="#0284C7" FontSize="8.5" FontWeight="Bold" />
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <Button Style="{StaticResource AccentButton}" Content="✨ Test Piko Alert" Click="TestAlert_Click" />
                                            <Button Style="{StaticResource PikoButton}" Content="🧠 Test Multi-AI" Click="TestMultiAi_Click" Margin="6,0,0,0" />
                                            <Button x:Name="SoundToggleButton" Style="{StaticResource PikoButton}" Content="♫ Sound On" Click="ToggleSound_Click" Margin="6,0,0,0" />
                                            <Button x:Name="DndToggleButton" Style="{StaticResource PikoButton}" Content="🔔 DND Off" Click="ToggleDnd_Click" Margin="6,0,0,0" />
                                            <Button Style="{StaticResource PikoButton}" Content="Dismiss" Click="DismissNotification_Click" Margin="6,0,0,0" />
                                        </StackPanel>

                                        <!-- Recent AI Events Log -->
                                        <TextBlock Text="RECENT EVENTS" Style="{StaticResource SectionLabel}" Margin="0,12,0,6" />
                                        <ScrollViewer MaxHeight="90" VerticalScrollBarVisibility="Auto">
                                            <StackPanel x:Name="RecentAiEventsPanel" />
                                        </ScrollViewer>
                                    </StackPanel>
                                </Border>

                                <!-- GOOGLE API OAUTH CONFIGURATION (OPTIONAL CUSTOM CLIENT ID) -->
                                <Border Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="GOOGLE CALENDAR API CONFIGURATION (OPTIONAL)" Style="{StaticResource SectionLabel}" Margin="0,0,0,4" />
                                        <TextBlock Text="Secara default Piko telah menyertakan integrasi Google OAuth 2.0. Anda juga dapat menggunakan Client ID &amp; Secret proyek Google Cloud Anda sendiri." Foreground="{StaticResource MutedBrush}" FontSize="10.5" Margin="0,0,0,8" TextWrapping="Wrap" />
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="6" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="6" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="GoogleClientIdInput" Grid.Column="0" Style="{StaticResource PikoTextBox}" Height="34" Tag="Custom Google Client ID..." Foreground="{DynamicResource InputForegroundBrush}" CaretBrush="{DynamicResource InputCaretBrush}" />
                                            <TextBox x:Name="GoogleClientSecretInput" Grid.Column="2" Style="{StaticResource PikoTextBox}" Height="34" Tag="Custom Client Secret..." Foreground="{DynamicResource InputForegroundBrush}" CaretBrush="{DynamicResource InputCaretBrush}" />
                                            <Button Grid.Column="4" Style="{StaticResource PikoButton}" Content="Simpan" Click="SaveGoogleApiConfig_Click" Height="34" Padding="12,4" Margin="0" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Background="#F6F3FF" BorderBrush="{StaticResource LightPurpleBrush}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,4,0,0">
                                    <StackPanel>
                                        <TextBlock Text="ABOUT PIKO" Style="{StaticResource SectionLabel}" />
                                        <TextBlock Text="Piko — Interactive AI Desktop Companion v0.3.0" Foreground="{StaticResource MainTextBrush}" FontSize="12" FontWeight="Bold" Margin="0,4,0,0" />
                                        <TextBlock Text="White/Purple 3D Glassmorphism Edition. Strictly local-first. Zero telemetry, multi-account calendar sync, loopback-only." Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,3,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <Button Style="{StaticResource PikoButton}" Content="Quit Piko Desktop" HorizontalAlignment="Right" Margin="0,12,0,0" Click="Quit_Click" />
                            </StackPanel>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- FOOTER STATUS -->
                    <TextBlock x:Name="DashboardFooterText" Grid.Row="2" Text="Piko · Your Tiny Desk Buddy" Foreground="{StaticResource MutedBrush}" FontSize="10" TextAlignment="Center" Margin="0,8,0,2" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
