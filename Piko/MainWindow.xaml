<Window x:Class="Piko.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Piko — Your Tiny Desk Buddy" Width="96" Height="36" MinWidth="80" MaxWidth="800" MinHeight="30" MaxHeight="600"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False"
        WindowStartupLocation="Manual" Top="0" UseLayoutRounding="True" SnapsToDevicePixels="True"
        WindowState="Normal" Visibility="Visible" Opacity="1.0" Focusable="True"
        Loaded="Window_Loaded" ContentRendered="Window_ContentRendered" Activated="Window_Activated" Deactivated="Window_Deactivated" StateChanged="Window_StateChanged" KeyDown="Window_KeyDown"
        Closing="Window_Closing" MouseEnter="Window_MouseEnter" MouseLeave="Window_MouseLeave" MouseMove="Window_MouseMove"
        PreviewMouseLeftButtonDown="Window_PreviewMouseLeftButtonDown" PreviewMouseMove="Window_PreviewMouseMove" PreviewMouseLeftButtonUp="Window_PreviewMouseLeftButtonUp"
        AllowDrop="True" DragEnter="Window_DragEnter" DragOver="Window_DragOver" DragLeave="Window_DragLeave" Drop="Window_Drop">
    <Window.Resources>
        <!-- SLEEPY ZZZ FLOATING ANIMATION LOOP -->
        <Storyboard x:Key="ZzzSleepStoryboard" RepeatBehavior="Forever">
            <!-- Z1 (Lead letter, starts immediately) -->
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Zzz1" Storyboard.TargetProperty="Opacity">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.0" Value="0.0" />
                <LinearDoubleKeyFrame KeyTime="0:0:0.3" Value="0.85" />
                <LinearDoubleKeyFrame KeyTime="0:0:1.1" Value="0.85" />
                <LinearDoubleKeyFrame KeyTime="0:0:1.5" Value="0.0" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimation Storyboard.TargetName="Zzz1Translate" Storyboard.TargetProperty="Y"
                             From="8" To="-7" Duration="0:0:1.5">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Zzz1Translate" Storyboard.TargetProperty="X"
                             From="2" To="7" Duration="0:0:1.5">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Zzz1Scale" Storyboard.TargetProperty="ScaleX"
                             From="0.8" To="1.15" Duration="0:0:1.5">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Zzz1Scale" Storyboard.TargetProperty="ScaleY"
                             From="0.8" To="1.15" Duration="0:0:1.5">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <!-- Z2 (Offset 0.45s) -->
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Zzz2" Storyboard.TargetProperty="Opacity" BeginTime="0:0:0.45">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.0" Value="0.0" />
                <LinearDoubleKeyFrame KeyTime="0:0:0.3" Value="0.80" />
                <LinearDoubleKeyFrame KeyTime="0:0:1.1" Value="0.80" />
                <LinearDoubleKeyFrame KeyTime="0:0:1.5" Value="0.0" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimation Storyboard.TargetName="Zzz2Translate" Storyboard.TargetProperty="Y" BeginTime="0:0:0.45"
                             From="10" To="-4" Duration="0:0:1.5">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Zzz2Translate" Storyboard.TargetProperty="X" BeginTime="0:0:0.45"
                             From="4" To="10" Duration="0:0:1.5">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Zzz2Scale" Storyboard.TargetProperty="ScaleX" BeginTime="0:0:0.45"
                             From="0.75" To="1.1" Duration="0:0:1.5">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Zzz2Scale" Storyboard.TargetProperty="ScaleY" BeginTime="0:0:0.45"
                             From="0.75" To="1.1" Duration="0:0:1.5">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <!-- Z3 (Offset 0.9s) -->
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Zzz3" Storyboard.TargetProperty="Opacity" BeginTime="0:0:0.9">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.0" Value="0.0" />
                <LinearDoubleKeyFrame KeyTime="0:0:0.3" Value="0.75" />
                <LinearDoubleKeyFrame KeyTime="0:0:1.1" Value="0.75" />
                <LinearDoubleKeyFrame KeyTime="0:0:1.5" Value="0.0" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimation Storyboard.TargetName="Zzz3Translate" Storyboard.TargetProperty="Y" BeginTime="0:0:0.9"
                             From="12" To="-1" Duration="0:0:1.5">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Zzz3Translate" Storyboard.TargetProperty="X" BeginTime="0:0:0.9"
                             From="6" To="13" Duration="0:0:1.5">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Zzz3Scale" Storyboard.TargetProperty="ScaleX" BeginTime="0:0:0.9"
                             From="0.7" To="1.05" Duration="0:0:1.5">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Zzz3Scale" Storyboard.TargetProperty="ScaleY" BeginTime="0:0:0.9"
                             From="0.7" To="1.05" Duration="0:0:1.5">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>
    <Grid>
        <!-- OBSIDIAN DYNAMIC ISLAND SHELL (Flush top edge, sleek pill bottom) -->
        <Border x:Name="Shell" Background="{StaticResource DarkIslandBrush}"
                BorderBrush="{StaticResource DarkIslandBorderBrush}" BorderThickness="1,0,1,1"
                CornerRadius="0,0,18,18" Padding="0" SnapsToDevicePixels="True" UseLayoutRounding="True" ClipToBounds="True"
                AllowDrop="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="TopHeaderRow" Height="Auto" />
                    <RowDefinition x:Name="MainContentRow" Height="*" />
                </Grid.RowDefinitions>

                <!-- DYNAMIC ISLAND BAR (TOP PERSISTENT HEADER, ALWAYS AT TOP=0, ZINDEX=1000) -->
                <Grid x:Name="IslandBar" Grid.Row="0" MinHeight="36" VerticalAlignment="Stretch" Panel.ZIndex="1000" ClipToBounds="False" AllowDrop="True">
                    
                    <!-- 1. Left: Brand Icon & Text (Visible ONLY when Dashboard is Expanded) -->
                    <StackPanel x:Name="BrandPanel" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed" HorizontalAlignment="Left" Margin="12,0,0,0">
                        <Border Width="20" Height="20" CornerRadius="10" Background="{StaticResource AccentGradientBrush}" Margin="0,0,6,0">
                            <TextBlock Text="✦" Foreground="#FFFFFF" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock x:Name="BrandText" Text="piko" Foreground="{StaticResource MainTextBrush}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- 2. Minimal Line-Eyes Capsule with Snug Headset Accessory (EyePair + Headset + Sleepy Zzz) -->
                    <!-- Persistently Centered Jet-Black Notch Capsule -->
                    <Border x:Name="MascotCapsule" Background="Transparent" BorderBrush="{StaticResource DarkIslandBorderBrush}"
                            BorderThickness="0" CornerRadius="0,0,14,14" Width="48" Height="28"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Hand"
                            Panel.ZIndex="1000" ToolTip="Klik untuk buka/tutup · Klik 2x lalu seret ke sisi layar · Klik 2x untuk kembali ke tengah"
                            MouseLeftButtonUp="MascotCapsule_MouseLeftButtonUp">
                        <Grid Width="48" Height="26" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <!-- Minimalist Headset Accessory (Shown only when media is active) -->
                            <Grid x:Name="HeadsetVisual" Width="44" Height="26" VerticalAlignment="Center" HorizontalAlignment="Center"
                                  Visibility="Collapsed" Opacity="0">
                                <Grid.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform x:Name="HeadsetScale" ScaleX="1" ScaleY="1" CenterX="22" CenterY="13" />
                                        <TranslateTransform x:Name="HeadsetTranslate" X="0" Y="-6" />
                                    </TransformGroup>
                                </Grid.RenderTransform>
                                
                                <!-- Headband Arc: snug arched lavender headband enclosing the vertical eyes -->
                                <Path x:Name="HeadsetArc"
                                      Data="M 4,14 C 4,3 40,3 40,14"
                                      Stroke="{StaticResource EyeActiveBrush}" StrokeThickness="1.8"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" SnapsToDevicePixels="True">
                                    <Path.Effect>
                                        <DropShadowEffect BlurRadius="3" Color="#BD87FF" Opacity="0.3" ShadowDepth="0" />
                                    </Path.Effect>
                                </Path>

                                <!-- Left Earcup: tiny 3.6x9px sleek pill -->
                                <Border x:Name="LeftEarcup" Width="3.6" Height="9" CornerRadius="1.8"
                                        Background="{StaticResource EyeActiveBrush}" BorderBrush="#181422" BorderThickness="0.5"
                                        HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="1,0,0,3">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="3" Color="#BD87FF" Opacity="0.3" ShadowDepth="0" />
                                    </Border.Effect>
                                </Border>

                                <!-- Right Earcup: tiny 3.6x9px sleek pill -->
                                <Border x:Name="RightEarcup" Width="3.6" Height="9" CornerRadius="1.8"
                                        Background="{StaticResource EyeActiveBrush}" BorderBrush="#181422" BorderThickness="0.5"
                                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,1,3">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="3" Color="#BD87FF" Opacity="0.3" ShadowDepth="0" />
                                    </Border.Effect>
                                </Border>
                            </Grid>

                            <!-- Piko's Line-Eyes Pair (Vertical Rounded Pills in Idle/Listening, Closed Arcs in Sleepy) -->
                            <Grid x:Name="EyePair" Width="30" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,1,0,0">
                                <Grid.RenderTransform>
                                    <TransformGroup>
                                        <TranslateTransform x:Name="EyePairTranslate" X="0" Y="0" />
                                        <ScaleTransform x:Name="EyePairScale" ScaleX="1" ScaleY="1" />
                                    </TransformGroup>
                                </Grid.RenderTransform>
                                <Grid.Effect>
                                    <DropShadowEffect x:Name="EyeGlowEffect" BlurRadius="5" Color="#BD87FF" Opacity="0.45" ShadowDepth="0" />
                                </Grid.Effect>

                                <!-- Left Eye Line (Vertical Rounded Pill in Idle) -->
                                <Canvas Width="14" Height="16" HorizontalAlignment="Left">
                                    <Path x:Name="LeftEyeLine"
                                          Data="M 7,2.5 L 7,12.5"
                                          Stroke="{StaticResource EyeActiveBrush}" StrokeThickness="4.5"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          RenderTransformOrigin="0.5,0.5" Canvas.Left="0" Canvas.Top="0">
                                        <Path.RenderTransform>
                                            <TransformGroup>
                                                <ScaleTransform x:Name="LeftEyeScale" ScaleX="1" ScaleY="1" />
                                                <RotateTransform x:Name="LeftEyeRotate" Angle="0" />
                                                <TranslateTransform x:Name="LeftEyeTranslate" X="0" Y="0" />
                                            </TransformGroup>
                                        </Path.RenderTransform>
                                    </Path>
                                </Canvas>

                                <!-- Right Eye Line (Vertical Rounded Pill in Idle) -->
                                <Canvas Width="14" Height="16" HorizontalAlignment="Right">
                                    <Path x:Name="RightEyeLine"
                                          Data="M 7,2.5 L 7,12.5"
                                          Stroke="{StaticResource EyeActiveBrush}" StrokeThickness="4.5"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          RenderTransformOrigin="0.5,0.5" Canvas.Left="0" Canvas.Top="0">
                                        <Path.RenderTransform>
                                            <TransformGroup>
                                                <ScaleTransform x:Name="RightEyeScale" ScaleX="1" ScaleY="1" />
                                                <RotateTransform x:Name="RightEyeRotate" Angle="0" />
                                                <TranslateTransform x:Name="RightEyeTranslate" X="0" Y="0" />
                                            </TransformGroup>
                                        </Path.RenderTransform>
                                    </Path>
                                </Canvas>
                            </Grid>

                            <!-- Floating Zzz Layer for Sleepy State -->
                            <Canvas x:Name="ZzzCanvas" Width="22" Height="22" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-3,0" IsHitTestVisible="False" Visibility="Collapsed">
                                <TextBlock x:Name="Zzz1" Text="Z" FontFamily="Segoe UI" FontWeight="Bold" FontSize="10" Foreground="{StaticResource ZzzBrush}" Opacity="0" Canvas.Left="0" Canvas.Top="0">
                                    <TextBlock.RenderTransform>
                                        <TransformGroup>
                                            <TranslateTransform x:Name="Zzz1Translate" X="2" Y="8" />
                                            <ScaleTransform x:Name="Zzz1Scale" ScaleX="0.8" ScaleY="0.8" />
                                        </TransformGroup>
                                    </TextBlock.RenderTransform>
                                    <TextBlock.Effect>
                                        <DropShadowEffect BlurRadius="3" Color="#BD87FF" Opacity="0.4" ShadowDepth="0" />
                                    </TextBlock.Effect>
                                </TextBlock>

                                <TextBlock x:Name="Zzz2" Text="z" FontFamily="Segoe UI" FontWeight="Bold" FontSize="8" Foreground="{StaticResource ZzzBrush}" Opacity="0" Canvas.Left="4" Canvas.Top="2">
                                    <TextBlock.RenderTransform>
                                        <TransformGroup>
                                            <TranslateTransform x:Name="Zzz2Translate" X="4" Y="10" />
                                            <ScaleTransform x:Name="Zzz2Scale" ScaleX="0.75" ScaleY="0.75" />
                                        </TransformGroup>
                                    </TextBlock.RenderTransform>
                                    <TextBlock.Effect>
                                        <DropShadowEffect BlurRadius="2" Color="#BD87FF" Opacity="0.35" ShadowDepth="0" />
                                    </TextBlock.Effect>
                                </TextBlock>

                                <TextBlock x:Name="Zzz3" Text="z" FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="6.5" Foreground="{StaticResource ZzzBrush}" Opacity="0" Canvas.Left="6" Canvas.Top="3">
                                    <TextBlock.RenderTransform>
                                        <TransformGroup>
                                            <TranslateTransform x:Name="Zzz3Translate" X="6" Y="12" />
                                            <ScaleTransform x:Name="Zzz3Scale" ScaleX="0.7" ScaleY="0.7" />
                                        </TransformGroup>
                                    </TextBlock.RenderTransform>
                                    <TextBlock.Effect>
                                        <DropShadowEffect BlurRadius="2" Color="#BD87FF" Opacity="0.3" ShadowDepth="0" />
                                    </TextBlock.Effect>
                                </TextBlock>
                            </Canvas>

                            <!-- Mini Music Pulse Dot (Visible during Idle if demo music is actively playing) -->
                            <Border x:Name="IdleMusicDot" Width="3" Height="3" CornerRadius="1.5" Background="{StaticResource PrimaryVioletBrush}"
                                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-2,1" Visibility="Collapsed"
                                    ToolTip="Musik sedang aktif 🎵" />
                        </Grid>
                    </Border>

                    <!-- Mini Pomodoro Compact Timer (Visible in Island when Focus is Active) -->
                    <Grid x:Name="IslandPomodoroPanel" Visibility="Collapsed" Margin="50,0,8,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="IslandPomodoroText" Text="25:00 #1" Foreground="#EDE5FF" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonUp="IslandPomodoro_MouseLeftButtonUp" ToolTip="Klik untuk buka tab Focus" />
                            
                            <!-- Pause / Resume Button -->
                            <Border x:Name="IslandPomodoroPlayPauseBtn" Background="#35FFFFFF" BorderBrush="#60A78BFA" BorderThickness="1" CornerRadius="9" Width="18" Height="18" Margin="6,0,0,0" Cursor="Hand" MouseLeftButtonUp="IslandPomodoroPlayPause_Click" ToolTip="Jeda / Lanjutkan Pomodoro">
                                <TextBlock x:Name="IslandPomodoroPlayPauseIcon" Text="⏸" Foreground="#FFFFFF" FontSize="8.5" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,1" />
                            </Border>

                            <Border x:Name="IslandPomodoroDot" Width="6" Height="6" CornerRadius="3" Background="#A78BFA" Margin="5,0,0,0" VerticalAlignment="Center">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="4" Color="#C084FC" Opacity="0.9" ShadowDepth="0" />
                                </Border.Effect>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Mini Water Reminder Compact Bar (Visible when WaterReminder is Active) -->
                    <Grid x:Name="IslandWaterReminderPanel" Visibility="Collapsed" Margin="52,0,10,0" VerticalAlignment="Center" Cursor="Hand" Background="Transparent" MouseLeftButtonUp="IslandWaterReminder_MouseLeftButtonUp" ToolTip="Waktunya minum air! Klik untuk catat minum &amp; reset pengingat">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="18" Height="18" CornerRadius="9" Background="#3300E5FF" BorderBrush="#8000E5FF" BorderThickness="1" Margin="0,0,6,0">
                                <TextBlock Text="💧" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Waktunya Minum Air!" Foreground="#E0F7FA" FontSize="11" FontWeight="Bold" />
                                <TextBlock Text="Klik Piko untuk catat minum" Foreground="#80DEEA" FontSize="9" />
                            </StackPanel>
                        </StackPanel>
                        <Border Grid.Column="1" Background="#2600E5FF" BorderBrush="#8000E5FF" BorderThickness="1" CornerRadius="8" Padding="6,2,6,2" VerticalAlignment="Center" Margin="6,0,0,0">
                            <TextBlock Text="DRINK 💧" Foreground="#00E5FF" FontSize="9" FontWeight="Bold" />
                        </Border>
                    </Grid>

                    <!-- Mini Music Compact Bar (Visible during MusicActive / MediaPaused) -->
                    <Grid x:Name="MusicActiveCompactPanel" Visibility="Collapsed" Margin="58,0,10,0" VerticalAlignment="Center" Cursor="Hand" Background="Transparent" MouseLeftButtonUp="MusicPanel_MouseLeftButtonUp">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Column 0: Media Title & Subtitle (Never overlaps eyes or equalizer) -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                            <TextBlock x:Name="MiniTrackTitle" Text="Now Playing" Foreground="#FFFFFF"
                                       FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                            <TextBlock x:Name="MiniTrackArtist" Text="YouTube · Playing"
                                       Foreground="#94A3B8" FontSize="9.5" Margin="0,1,0,0"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                        </StackPanel>

                        <!-- Column 1: Equalizer Visualizer & Hover Play/Pause on Far Right -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- 5-bar Equalizer Visualizer (Far Right) -->
                            <StackPanel x:Name="EqualizerBarsPanel" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,2,0">
                                <Border x:Name="EqBar1" Width="2.4" Height="8" CornerRadius="1.2" Background="{StaticResource EyeActiveBrush}" Margin="0,0,2,0" />
                                <Border x:Name="EqBar2" Width="2.4" Height="14" CornerRadius="1.2" Background="{StaticResource EyeActiveBrush}" Margin="0,0,2,0" />
                                <Border x:Name="EqBar3" Width="2.4" Height="6" CornerRadius="1.2" Background="{StaticResource EyeActiveBrush}" Margin="0,0,2,0" />
                                <Border x:Name="EqBar4" Width="2.4" Height="16" CornerRadius="1.2" Background="{StaticResource EyeActiveBrush}" Margin="0,0,2,0" />
                                <Border x:Name="EqBar5" Width="2.4" Height="9" CornerRadius="1.2" Background="{StaticResource EyeActiveBrush}" />
                            </StackPanel>

                            <!-- Mini Play/Pause button (Visible on Hover) -->
                            <Button x:Name="MiniPlayPauseBtn" Content="⏸" Style="{StaticResource DarkIslandButton}"
                                    Width="22" Height="22" Padding="0" FontSize="9" Margin="3,0,0,0"
                                    ToolTip="Play / Pause" Click="MiniPlayPause_Click" VerticalAlignment="Center"
                                    Visibility="Collapsed" />
                        </StackPanel>
                    </Grid>

                    <!-- 3. Dynamic Activity Expansion Bar (Visible in AiWorking, Success, Notification) -->
                    <Grid x:Name="ActivityPanel" Visibility="Collapsed" Margin="60,0,6,0" VerticalAlignment="Center">
                        
                        <!-- 3A. AI Working Panel -->
                        <Grid x:Name="AiWorkingPanel" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonUp="Header_MouseLeftButtonUp">
                                <TextBlock x:Name="AiThinkingDots" Text="•••" Foreground="#C084FC" FontSize="12" FontWeight="Bold" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="AiWorkingText" Text="Piko sedang berpikir..." Foreground="#FFFFFF" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="195" />
                            </StackPanel>
                            <Border Grid.Column="1" Background="#261E38" BorderBrush="#3D305A" BorderThickness="1" CornerRadius="8" Padding="6,2,6,2" VerticalAlignment="Center" Margin="4,0,0,0">
                                <TextBlock x:Name="AiWorkingTag" Text="AI" Foreground="#C084FC" FontSize="9" FontWeight="Bold" />
                            </Border>
                        </Grid>

                        <!-- 3B. AI Success Panel -->
                        <Grid x:Name="SuccessPanel" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Cursor="Hand" MouseLeftButtonUp="SuccessPanel_MouseLeftButtonUp">
                                <TextBlock x:Name="SuccessTitle" Text="Selesai! ✨" Foreground="#C084FC" FontSize="11" FontWeight="Bold" />
                                <TextBlock x:Name="SuccessSubtext" Text="Jawaban sudah siap ✨" Foreground="#F1F5F9" FontSize="10" TextTrimming="CharacterEllipsis" MaxWidth="215" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="✕" Style="{StaticResource DarkIslandButton}" Width="20" Height="20" Padding="0" FontSize="9" ToolTip="Tutup notifikasi" Click="DismissActivity_Click" VerticalAlignment="Center" />
                        </Grid>

                        <!-- 3C. Music Active Panel (Detailed) -->
                        <Grid x:Name="MusicActivePanel" Visibility="Collapsed" Cursor="Hand" Background="Transparent" MouseLeftButtonUp="MusicPanel_MouseLeftButtonUp">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                                <Border x:Name="DetailedEqBar1" Width="2.5" Height="10" CornerRadius="1" Background="#A78BFA" Margin="0,0,1.5,0" />
                                <Border x:Name="DetailedEqBar2" Width="2.5" Height="14" CornerRadius="1" Background="#C084FC" Margin="0,0,1.5,0" />
                                <Border x:Name="DetailedEqBar3" Width="2.5" Height="8" CornerRadius="1" Background="#8B5CF6" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="IslandTrackTitle" Text="Midnight City" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold" TextTrimming="CharacterEllipsis" MaxWidth="185" />
                                <TextBlock x:Name="IslandTrackArtist" Text="M83 · demo track" Foreground="#A5B4FC" FontSize="9" TextTrimming="CharacterEllipsis" MaxWidth="185" />
                            </StackPanel>
                            <Button Grid.Column="2" Content="✕" Style="{StaticResource DarkIslandButton}" Width="20" Height="20" Padding="0" FontSize="9" ToolTip="Ciutkan ke idle" Click="DismissActivity_Click" VerticalAlignment="Center" />
                        </Grid>

                        <!-- 3D. Generic / Timer / Hydration Notification Panel -->
                        <Grid x:Name="NotificationPanel" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="NotifIcon" Text="💧" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="NotifTitle" Text="Waktunya Minum Air!" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold" TextTrimming="CharacterEllipsis" MaxWidth="210" />
                                <TextBlock x:Name="NotifBody" Text="Tetap hidrasi sepanjang hari ✨" Foreground="#C4B5FD" FontSize="9" TextTrimming="CharacterEllipsis" MaxWidth="210" />
                            </StackPanel>
                        </Grid>

                        <!-- 3E. File Eating Panel (Direct Drag-and-Drop to Shelf) -->
                        <Grid x:Name="FileEatingPanel" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="26" Height="26" CornerRadius="13" Background="#351C54" BorderBrush="#BD87FF" BorderThickness="1.5" VerticalAlignment="Center" Margin="0,0,8,0">
                                <TextBlock x:Name="FileEatingIcon" Text="📂" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Drag dan lepaskan temporary file ke Piko" Foreground="#FFFFFF" FontSize="10.5" FontWeight="Bold" TextTrimming="CharacterEllipsis" MaxWidth="260" />
                                <TextBlock Text="Akan disimpan ke Temporary Shelf 📎" Foreground="#C084FC" FontSize="9" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="260" />
                            </StackPanel>
                        </Grid>

                    </Grid>

                    <!-- 4. Right: Quick Dashboard Controls & Clock (Visible ONLY when Dashboard is Expanded) -->
                    <StackPanel x:Name="HeaderControls" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" Visibility="Collapsed" Margin="0,0,12,0">
                        <TextBlock x:Name="MiniStatusText" Text="piko is ready" Foreground="{StaticResource DeepVioletBrush}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" TextTrimming="CharacterEllipsis" MaxWidth="120" />
                        <TextBlock x:Name="ClockText" Text="16:35" Foreground="{StaticResource MainTextBrush}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <Button x:Name="DndMiniButton" Content="🔔" Style="{StaticResource PikoButton}" Width="26" Height="26" Padding="0" Margin="0,0,4,0" ToolTip="Toggle Do Not Disturb" Click="ToggleDnd_Click" />
                        <Button x:Name="ExpandToggleMiniButton" Content="📌" Style="{StaticResource PikoButton}" Width="26" Height="26" Padding="0" Margin="0,0,4,0" ToolTip="Pin / Unpin Panel" Click="TogglePin_Click" />
                        <Button x:Name="QuitMiniButton" Content="✕" Style="{StaticResource PikoButton}" Width="26" Height="26" Padding="0" Margin="0" ToolTip="Tutup Panel (Kembali ke Notch)" Click="QuitMiniButton_Click" />
                    </StackPanel>

                </Grid>

                <!-- EXPANDED BALANCED GLASS PANEL (STARTS RIGHT UNDER THE PERSISTENT NOTCH) -->
                <Grid x:Name="ExpandedContent" Grid.Row="1" Visibility="Collapsed" Opacity="0" Margin="8,4,8,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- TAB NAVIGATION HEADER (9 Tabs: Home, Music, Focus, Water, Tasks, Files, Storage, AI, Settings) -->
                    <Border Grid.Row="0" Background="#90FFFFFF" BorderBrush="{StaticResource LightPurpleBrush}" BorderThickness="1" CornerRadius="14" Padding="3" Margin="0,0,0,10">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="TabHome" GroupName="MainTabNav" Style="{StaticResource TabNavButton}" Content="🏠 Home" IsChecked="True" Checked="Tab_Checked" />
                                <RadioButton x:Name="TabMusic" GroupName="MainTabNav" Style="{StaticResource TabNavButton}" Content="🎵 Music" Checked="Tab_Checked" />
                                <RadioButton x:Name="TabFocus" GroupName="MainTabNav" Style="{StaticResource TabNavButton}" Content="⏱️ Focus" Checked="Tab_Checked" />
                                <RadioButton x:Name="TabWater" GroupName="MainTabNav" Style="{StaticResource TabNavButton}" Content="💧 Water" Checked="Tab_Checked" />
                                <RadioButton x:Name="TabTasks" GroupName="MainTabNav" Style="{StaticResource TabNavButton}" Content="📝 Tasks" Checked="Tab_Checked" />
                                <RadioButton x:Name="TabShelf" GroupName="MainTabNav" Style="{StaticResource TabNavButton}" Content="📎 Files" Checked="Tab_Checked" />
                                <RadioButton x:Name="TabStorage" GroupName="MainTabNav" Style="{StaticResource TabNavButton}" Content="📁 Storage" Checked="Tab_Checked" />
                                <RadioButton x:Name="TabCalendar" GroupName="MainTabNav" Style="{StaticResource TabNavButton}" Content="📅 Calendar" Checked="Tab_Checked" />
                                <RadioButton x:Name="TabSettings" GroupName="MainTabNav" Style="{StaticResource TabNavButton}" Content="⚙️ Settings" Checked="Tab_Checked" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- TAB PANELS CONTAINER -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,4,0">

                            <!-- TAB 1: HOME DASHBOARD -->
                            <StackPanel x:Name="PanelHome" Visibility="Visible">
                                <!-- Mascot Greeting Hero Card -->
                                <Border Style="{StaticResource CardStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Minimalist Line-Eyes Brand Emblem -->
                                        <Border Grid.Column="0" Width="48" Height="48" CornerRadius="16" Background="#181528" BorderBrush="#3D345A" BorderThickness="1.2" Margin="0,0,12,0" VerticalAlignment="Center">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="10" Color="#8B5CF6" Opacity="0.35" ShadowDepth="0" />
                                            </Border.Effect>
                                            <Canvas Width="28" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Path Data="M 1 4 Q 6 6.5 11 4" Stroke="#FFFFFF" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                                <Path Data="M 17 4 Q 22 6.5 27 4" Stroke="#FFFFFF" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                            </Canvas>
                                        </Border>

                                        <!-- Greeting Text -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="PIKO DESK COMPANION" Style="{StaticResource SectionLabel}" />
                                            <TextBlock x:Name="HomeGreetingTitle" Text="Halo! Piko siap menemani harimu ✨" Foreground="{StaticResource MainTextBrush}" FontSize="15" FontWeight="Bold" Margin="0,2,0,0" />
                                            <TextBlock x:Name="HomeGreetingSubtitle" Text="Notch cerdas untuk notifikasi AI, fokus, hidrasi &amp; file." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,2,0,0" />
                                        </StackPanel>

                                        <!-- Status Chip -->
                                        <Border Grid.Column="2" Background="{StaticResource SoftChipBrush}" BorderBrush="{StaticResource LightPurpleBrush}" BorderThickness="1" CornerRadius="10" Padding="8,4" VerticalAlignment="Top">
                                            <TextBlock x:Name="HomeEmotionBadge" Text="SNOOZING" Foreground="{StaticResource DeepVioletBrush}" FontSize="9" FontWeight="Bold" />
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- 4 Quick Glance Cards Grid -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="10" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Focus Preview Card -->
                                    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0">
                                        <StackPanel>
                                            <TextBlock Text="FOCUS TIMER" Style="{StaticResource SectionLabel}" />
                                            <TextBlock x:Name="HomeFocusText" Text="25:00" Foreground="{StaticResource MainTextBrush}" FontSize="24" FontWeight="Bold" Margin="0,4,0,2" />
                                            <Button Style="{StaticResource AccentButton}" Content="Mulai Fokus" Click="HomeFocusJump_Click" HorizontalAlignment="Left" Padding="10,5" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Water Preview Card -->
                                    <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource CardStyle}" Margin="0">
                                        <StackPanel>
                                            <TextBlock Text="HYDRATION" Style="{StaticResource SectionLabel}" />
                                            <TextBlock x:Name="HomeWaterText" Text="0 / 8 gelas" Foreground="{StaticResource MainTextBrush}" FontSize="20" FontWeight="Bold" Margin="0,4,0,4" />
                                            <ProgressBar x:Name="HomeWaterProgress" Minimum="0" Maximum="100" Value="0" Height="5" Background="#E4DEFF" Foreground="{StaticResource PrimaryVioletBrush}" BorderThickness="0" Margin="0,0,0,6" />
                                            <Button Style="{StaticResource PikoButton}" Content="＋ Minum Air" Click="AddWater_Click" HorizontalAlignment="Left" Padding="10,4" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Music Preview Card -->
                                    <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0">
                                        <StackPanel>
                                            <TextBlock Text="NOW PLAYING" Style="{StaticResource SectionLabel}" />
                                            <TextBlock x:Name="HomeTrackText" Text="Midnight City" Foreground="{StaticResource MainTextBrush}" FontSize="13" FontWeight="Bold" TextTrimming="CharacterEllipsis" Margin="0,4,0,1" />
                                            <TextBlock x:Name="HomeArtistText" Text="M83 · demo track" Foreground="{StaticResource MutedBrush}" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,0,0,6" />
                                            <Button x:Name="HomePlayPauseBtn" Style="{StaticResource PikoButton}" Content="▶ Play Demo" Click="PlayPauseButton_Click" HorizontalAlignment="Left" Padding="10,4" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Tasks Preview Card -->
                                    <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource CardStyle}" Margin="0">
                                        <StackPanel>
                                            <TextBlock Text="TODAY'S TASKS" Style="{StaticResource SectionLabel}" />
                                            <TextBlock x:Name="HomeTasksCountText" Text="0 tugas terbuka" Foreground="{StaticResource MainTextBrush}" FontSize="16" FontWeight="Bold" Margin="0,4,0,2" />
                                            <TextBlock x:Name="HomeTopTaskText" Text="Tidak ada tugas tertunda." Foreground="{StaticResource MutedBrush}" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,0,0,6" />
                                            <Button Style="{StaticResource PikoButton}" Content="Buka Daftar" Click="HomeTasksJump_Click" HorizontalAlignment="Left" Padding="10,4" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>

                            <!-- TAB 2: MUSIC -->
                            <StackPanel x:Name="PanelMusic" Visibility="Collapsed">
                                <Border Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,10">
                                            <StackPanel>
                                                <TextBlock Text="DESKTOP SOUNDTRACK" Style="{StaticResource SectionLabel}" />
                                                <TextBlock Text="Real-Time Media Player" Foreground="{StaticResource MainTextBrush}" FontSize="16" FontWeight="Bold" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <Border x:Name="TrackModeBadge" HorizontalAlignment="Right" VerticalAlignment="Top" Background="{StaticResource SoftChipBrush}" CornerRadius="8" Padding="7,4">
                                                <TextBlock x:Name="TrackModeBadgeText" Text="STANDBY" Foreground="{StaticResource DeepVioletBrush}" FontSize="9" FontWeight="Bold" />
                                            </Border>
                                        </Grid>

                                        <Grid Margin="0,4,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="52" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="48" Height="48" CornerRadius="12" Background="{StaticResource SoftChipBrush}" BorderBrush="{StaticResource LightPurpleBrush}" BorderThickness="1" ClipToBounds="True">
                                                <Grid>
                                                    <TextBlock x:Name="TrackArtworkFallback" Text="♫" Foreground="{StaticResource PrimaryVioletBrush}" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    <Image x:Name="TrackArtworkImage" Stretch="UniformToFill" Visibility="Collapsed" />
                                                </Grid>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                                <TextBlock x:Name="TrackTitleText" Text="Belum ada media yang diputar" Foreground="{StaticResource MainTextBrush}" FontSize="14" FontWeight="Bold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                                <TextBlock x:Name="TrackArtistText" Text="Putar musik atau video di YouTube Chrome" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- Playback Progress Bar & Time -->
                                        <Grid Margin="0,0,0,10" x:Name="TrackProgressGrid">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <ProgressBar x:Name="TrackProgressBar" Minimum="0" Maximum="100" Value="0" Height="4" Background="#E4DEFF" Foreground="{StaticResource PrimaryVioletBrush}" BorderThickness="0" Margin="0,0,0,3" />
                                            <Grid Grid.Row="1">
                                                <TextBlock x:Name="TrackCurrentTimeText" Text="0:00" Foreground="{StaticResource MutedBrush}" FontSize="9.5" HorizontalAlignment="Left" />
                                                <TextBlock x:Name="TrackDurationText" Text="0:00" Foreground="{StaticResource MutedBrush}" FontSize="9.5" HorizontalAlignment="Right" />
                                            </Grid>
                                        </Grid>

                                        <!-- Media Controls -->
                                        <WrapPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <Button x:Name="PrevTrackBtn" Style="{StaticResource PikoButton}" Content="‹‹ Prev" Click="PreviousTrack_Click" Margin="0,0,6,4" ToolTip="Video Sebelumnya" />
                                            <Button x:Name="PlayPauseButton" Style="{StaticResource AccentButton}" Content="▶ Play" Click="PlayPauseButton_Click" Margin="0,0,6,4" ToolTip="Play / Pause" />
                                            <Button x:Name="NextTrackBtn" Style="{StaticResource PikoButton}" Content="Next ››" Click="NextTrack_Click" Margin="0,0,6,4" ToolTip="Video Berikutnya" />
                                            <Button x:Name="OpenBrowserButton" Style="{StaticResource PikoButton}" Content="🌐 Buka YouTube" Click="OpenBrowserMedia_Click" Margin="0,0,6,4" ToolTip="Buka video di browser" />
                                            <Button x:Name="DemoToggleBtn" Style="{StaticResource PikoButton}" Content="🎵 Demo Mode" Click="DemoTrackToggle_Click" Margin="0,0,6,4" ToolTip="Putar Track Demo" />
                                        </WrapPanel>

                                        <TextBlock x:Name="MediaStatusText" Text="Belum ada media yang diputar. Putar video di YouTube Chrome untuk sinkronisasi otomatis." Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" />

                                        <!-- Lyrics Card -->
                                        <Border x:Name="LyricsPanel" Visibility="Collapsed" Background="#F6F3FF" BorderBrush="{StaticResource LightPurpleBrush}" BorderThickness="1" CornerRadius="14" Padding="12" Margin="0,10,0,0">
                                            <StackPanel>
                                                <TextBlock Text="LYRICS PREVIEW" Style="{StaticResource SectionLabel}" Margin="0,0,0,4" />
                                                <TextBlock Text="“The city is my church, it wraps in the blinding twilight…”" Foreground="{StaticResource DeepVioletBrush}" FontSize="12" FontWeight="SemiBold" FontStyle="Italic" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- TAB 3: FOCUS (AUTO-INTERVAL POMODORO) -->
                            <StackPanel x:Name="PanelFocus" Visibility="Collapsed">
                                <Border Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <!-- Header & Mode Pill -->
                                        <Grid Margin="0,0,0,10">
                                            <StackPanel>
                                                <TextBlock Text="TEKNIK POMODORO" Style="{StaticResource SectionLabel}" />
                                                <TextBlock Text="Siklus Fokus 25m &amp; Istirahat Otomatis" Foreground="{StaticResource MainTextBrush}" FontSize="15" FontWeight="Bold" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <Border x:Name="PomodoroPhaseBadge" Background="#287C3AED" BorderBrush="#5C3EA8" BorderThickness="1" CornerRadius="12" Padding="10,3" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock x:Name="PomodoroPhaseBadgeText" Text="SESI FOKUS #1 (25m)" Foreground="{StaticResource PrimaryVioletBrush}" FontSize="10.5" FontWeight="Bold" />
                                            </Border>
                                        </Grid>

                                        <!-- Step 1: Pilih Tugas Yang Ingin Diselesaikan -->
                                        <Border Background="{DynamicResource SoftChipBrush}" BorderBrush="{StaticResource LightPurpleBrush}" BorderThickness="1" CornerRadius="12" Padding="10,8" Margin="0,0,0,12">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,4">
                                                    <TextBlock Text="🎯 TARGET TUGAS FOKUS" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" />
                                                    <TextBlock Text="Pilih tugas sebelum mulai" Foreground="{StaticResource LavenderBrush}" FontSize="9.5" HorizontalAlignment="Right" />
                                                </Grid>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <ComboBox x:Name="PomodoroTaskCombo" IsEditable="True" Height="32" FontSize="11" Padding="6,4" VerticalContentAlignment="Center" Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource InputForegroundBrush}" BorderBrush="{DynamicResource InputBorderBrush}" SelectionChanged="PomodoroTaskCombo_SelectionChanged" />
                                                    <Button Grid.Column="1" Style="{StaticResource PikoButton}" Content="🔄 Muat Tugas" Click="RefreshPomodoroTasks_Click" Padding="8,4" Margin="6,0,0,0" ToolTip="Muat daftar tugas terbaru dari Little List" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- Step 4: 4-Session Pomodoro Cycle Indicator -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="1.2*" />
                                            </Grid.ColumnDefinitions>

                                            <Border x:Name="PomoStep1Border" Grid.Column="0" Background="#357C3AED" BorderBrush="#7C3AED" BorderThickness="1.5" CornerRadius="8" Padding="4,5" Margin="0,0,4,0">
                                                <TextBlock x:Name="PomoStep1Text" Text="Sesi 1" Foreground="{StaticResource MainTextBrush}" FontSize="9.5" FontWeight="Bold" HorizontalAlignment="Center" />
                                            </Border>
                                            <Border x:Name="PomoStep2Border" Grid.Column="1" Background="{DynamicResource SoftChipBrush}" BorderBrush="{StaticResource LightPurpleBrush}" BorderThickness="1" CornerRadius="8" Padding="4,5" Margin="0,0,4,0">
                                                <TextBlock x:Name="PomoStep2Text" Text="Sesi 2" Foreground="{StaticResource MutedBrush}" FontSize="9.5" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                            </Border>
                                            <Border x:Name="PomoStep3Border" Grid.Column="2" Background="{DynamicResource SoftChipBrush}" BorderBrush="{StaticResource LightPurpleBrush}" BorderThickness="1" CornerRadius="8" Padding="4,5" Margin="0,0,4,0">
                                                <TextBlock x:Name="PomoStep3Text" Text="Sesi 3" Foreground="{StaticResource MutedBrush}" FontSize="9.5" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                            </Border>
                                            <Border x:Name="PomoStep4Border" Grid.Column="3" Background="{DynamicResource SoftChipBrush}" BorderBrush="{StaticResource LightPurpleBrush}" BorderThickness="1" CornerRadius="8" Padding="4,5" Margin="0,0,4,0">
                                                <TextBlock x:Name="PomoStep4Text" Text="Sesi 4" Foreground="{StaticResource MutedBrush}" FontSize="9.5" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                            </Border>
                                            <Border x:Name="PomoStepLongBorder" Grid.Column="4" Background="{DynamicResource SoftChipBrush}" BorderBrush="{StaticResource LightPurpleBrush}" BorderThickness="1" CornerRadius="8" Padding="4,5">
                                                <TextBlock x:Name="PomoStepLongText" Text="Break 15m" Foreground="{StaticResource MutedBrush}" FontSize="9.5" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                            </Border>
                                        </Grid>

                                        <!-- Giant Countdown Timer & Status -->
                                        <TextBlock x:Name="FocusTimerText" Text="25:00" Foreground="{StaticResource MainTextBrush}" FontSize="46" FontWeight="Light" Margin="0,4,0,2" HorizontalAlignment="Center" />
                                        <TextBlock x:Name="FocusStatusText" Text="Fokus penuh 25 menit pada tugas Anda tanpa gangguan ✨" Foreground="{StaticResource MutedBrush}" FontSize="11.5" HorizontalAlignment="Center" Margin="0,0,0,12" />

                                        <!-- Controls Bar -->
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                                            <Button x:Name="FocusStartButton" Style="{StaticResource AccentButton}" Content="▶ Mulai Fokus (25m)" Padding="18,7" Click="FocusStartButton_Click" Margin="0,0,8,0" />
                                            <Button x:Name="FocusSkipButton" Style="{StaticResource PikoButton}" Content="⏭ Lewati Interval" Padding="12,7" Click="FocusSkipButton_Click" Margin="0,0,8,0" ToolTip="Lewati langsung ke tahap istirahat atau sesi berikutnya" />
                                            <Button Style="{StaticResource PikoButton}" Content="↺ Reset Siklus" Padding="12,7" Click="FocusResetButton_Click" Margin="0" ToolTip="Kembalikan siklus ke Sesi 1 (25 menit)" />
                                        </StackPanel>

                                        <!-- Auto Interval Settings & Duration Customization -->
                                        <Border Background="{DynamicResource SoftChipBrush}" BorderBrush="{StaticResource LightPurpleBrush}" BorderThickness="1" CornerRadius="10" Padding="10,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox x:Name="PomodoroAutoAdvanceCheck" Content="⚡ Auto-Lanjut interval (otomatis pindah kerja/istirahat)" IsChecked="True" Foreground="{StaticResource MainTextBrush}" FontSize="10.5" VerticalAlignment="Center" Checked="PomodoroSettings_Changed" Unchecked="PomodoroSettings_Changed" />
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="Istirahat Panjang:" Foreground="{StaticResource MutedBrush}" FontSize="10.5" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                    <ComboBox x:Name="PomodoroLongBreakCombo" SelectedIndex="0" Height="26" FontSize="10" Padding="4,2" SelectionChanged="PomodoroSettings_Changed" Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource InputForegroundBrush}" BorderBrush="{DynamicResource InputBorderBrush}">
                                                        <ComboBoxItem Content="15 Menit" Tag="15" />
                                                        <ComboBoxItem Content="20 Menit" Tag="20" />
                                                        <ComboBoxItem Content="30 Menit" Tag="30" />
                                                    </ComboBox>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- TAB 4: WATER (DAILY HYDRATION REMINDER) -->
                            <StackPanel x:Name="PanelWater" Visibility="Collapsed">
                                <!-- Reminder Control & Timer Card -->
                                <Border Style="{StaticResource CardStyle}">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,8">
                                            <StackPanel>
                                                <TextBlock Text="DAILY HYDRATION REMINDER" Style="{StaticResource SectionLabel}" />
                                                <TextBlock Text="Pengingat Minum Otomatis" Foreground="{StaticResource MainTextBrush}" FontSize="16" FontWeight="Bold" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <Button x:Name="WaterReminderToggleBtn" Style="{StaticResource PikoButton}" Content="🔔 Pengingat: Aktif" Click="WaterReminderToggle_Click" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="10,4" />
                                        </Grid>

                                        <Border Background="#F0FDF4" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="10" Padding="10,8" Margin="0,4,0,12" x:Name="WaterCountdownBox">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="STATUS PENGINGAT" Foreground="#166534" FontSize="9" FontWeight="Bold" />
                                                    <TextBlock x:Name="WaterCountdownText" Text="⏳ Pengingat berikutnya dalam: 45:00" Foreground="#15803D" FontSize="12" FontWeight="SemiBold" Margin="0,2,0,0" />
                                                </StackPanel>
                                                <TextBlock Text="💧 Piko Siaga" Grid.Column="1" Foreground="#16A34A" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>

                                        <!-- Interval Selection -->
                                        <TextBlock Text="Atur Interval Pengingat:" Foreground="{StaticResource MainTextBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6" />
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
